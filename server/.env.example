# server/.env.example
# 复制此文件为 .env，填入真实的 Key

# ── AI 模型 ──────────────────────────────────────────────────────
# DeepSeek API Key（对话/合同审查模型）
# 申请地址：https://platform.deepseek.com
# 不配置也能启动服务（注册/登录/管理功能正常），仅 AI 功能不可用
DEEPSEEK_API_KEY=
PRIMARY_MODEL=deepseek-chat

# Embedding 服务（RAG/合同条款检索需要），走 OpenAI 兼容接口
# 推荐硅基流动 BAAI/bge-m3：https://siliconflow.cn
OPENAI_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_BASE_URL=https://api.siliconflow.cn/v1

# 智谱 Embedding（与上面二选一，配置后优先使用）
ZHIPU_API_KEY=

# Tavily 联网搜索（Agent 真搜索工具，不配置则隐藏该工具）
# 申请地址：https://tavily.com
TAVILY_API_KEY=

# ── 服务 ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# 精确缓存过期时间（毫秒，默认 30 分钟；生产由 Redis 托管）
CACHE_TTL=1800000

# ── 数据库 / 缓存 ───────────────────────────────────────────────
DATABASE_URL=postgresql://workmind@localhost:5432/workmind?schema=public
REDIS_URL=redis://localhost:6379

# ── JWT 认证（生产环境务必替换为强随机字符串）────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ── 邮箱验证码 ──────────────────────────────────────────────────
# dev 演示：true=验证码打印在后端控制台，并接受固定码 123456（仅限本地开发）。
# 生产必须 false 或不设置（未设置时生产自动为 false），固定码通道在生产环境硬禁用
MAILER_CONSOLE=true
EMAIL_CODE_FIXED=123456
# 生产 SMTP（MAILER_CONSOLE=false 时生效），如 smtp.feishu.cn / smtp.exmail.qq.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WorkMind <no-reply@workmind.example>"
