{
  "name": "clausemind-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && node --max-old-space-size=4096 node_modules/typescript/lib/tsc.js -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only -r ./register-js-ext.cjs src/main.ts",
    "start": "node dist/main.js",
    "seed": "ts-node --transpile-only -r ./register-js-ext.cjs prisma/seed.ts",
    "eval": "ts-node --transpile-only -r ./register-js-ext.cjs scripts/run-eval.ts",
    "sync:feedback": "ts-node --transpile-only -r ./register-js-ext.cjs scripts/sync-feedback.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only -r ./register-js-ext.cjs prisma/seed.ts"
  },
  "dependencies": {
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/langgraph-checkpoint-postgres": "^0.0.5",
    "@langchain/mcp-adapters": "^0.5.4",
    "@langchain/openai": "^0.3.0",
    "@langchain/textsplitters": "^0.1.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.21.5",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.1",
    "mathjs": "^15.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "xss": "^1.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.7.3"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.12.1"
  }
}
