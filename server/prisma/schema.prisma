// Prisma Schema — WorkMind 合同风险审查平台
// 分层：平台层（Tenant/Quota/Trace/Span/Eval）+ 业务层（Contract/Clause/Review/Risk/Rule）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════ 平台层：租户与用户 ════════════════════════

model Tenant {
  id                String         @id @default(cuid())
  name              String         @db.VarChar(100)
  plan              TenantPlan     @default(FREE)
  workspaceType     WorkspaceType  @default(PERSONAL) @map("workspace_type")
  status            TenantStatus   @default(ACTIVE)
  couponBalance     Int            @default(0) @map("coupon_balance")
  planUpdatedAt     DateTime?      @map("plan_updated_at")
  planExpiresAt     DateTime?      @map("plan_expires_at") @db.Timestamptz(6)
  // 取消订阅（模拟）：权益保留至 planExpiresAt，到期后由定时任务降级 FREE
  cancelAtPeriodEnd Boolean        @default(false) @map("cancel_at_period_end")
  monthlyTokenQuota Int            @default(500000) @map("monthly_token_quota")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  users              User[]
  contracts          Contract[]
  reviewTasks        ReviewTask[]
  traces             Trace[]
  quotaUsage         QuotaUsage[]
  ledgers            ContractLedger[]
  playbookRules      PlaybookRule[]
  orders             Order[]
  integrationConfigs IntegrationConfig[]
  integrationLeads   IntegrationLead[]

  @@map("tenants")
}

// 四档套餐：FREE / PERSONAL 个人版 / TEAM 团队版 / ENTERPRISE 企业版
// 历史值 PRO/ENT 已在迁移中映射为 TEAM/ENTERPRISE，物理枚举仍保留但业务不再使用。
enum TenantPlan {
  FREE
  PERSONAL
  TEAM
  ENTERPRISE
}

// 工作空间类型：个人单成员空间 / 企业团队空间
enum WorkspaceType {
  PERSONAL
  TEAM
}

enum TenantStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique @db.VarChar(50)
  email        String?    @unique @db.VarChar(100)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String?    @map("display_name") @db.VarChar(100)
  avatar       String?    @db.VarChar(500)
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  tenantId     String     @map("tenant_id") @db.VarChar(50)
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  emailVerified       Boolean @default(false) @map("email_verified")
  metadata    Json?
  lastLoginAt  DateTime?  @map("last_login_at")
  lastLoginIp  String?    @map("last_login_ip") @db.VarChar(45)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      ChatSession[]
  messages      Message[]
  uploadedDocs  Document[]     @relation("DocumentUploader")
  contracts     Contract[]     @relation("ContractUploader")
  reviewTasks   ReviewTask[]   @relation("Reviewer")
  auditLogs     AuditLog[]
  traces        Trace[]
  refreshTokens RefreshToken[]
  ledgers       ContractLedger[]
  playbookRules PlaybookRule[]
  orders        Order[]
  integrationLeads IntegrationLead[] @relation("IntegrationLeadUser")

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  ADMIN    // 平台管理员
  MANAGER  // 审查负责人：分配/终审
  USER     // 普通成员：发起审查
  READONLY
}

enum UserStatus {
  ACTIVE
  DISABLED
  PENDING
}

// 租户按月配额用量（计费/账单架构口，唯一键 = 租户 + 月份）
model QuotaUsage {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  period       String   @db.VarChar(7) // YYYY-MM
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costCny      Decimal  @default(0) @map("cost_cny") @db.Decimal(10, 4)
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("quota_usage")
}

// ════════════════════════ 平台层：对话 ════════════════════════

model ChatSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String   @default("新对话") @db.VarChar(200)
  role      String   @default("default") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("chat_sessions")
}

model Message {
  id           String      @id @default(cuid())
  sessionId    String      @map("session_id")
  userId       String?     @map("user_id")
  contractId   String?     @map("contract_id") // 合同追问上下文（可选）
  role         MessageRole
  content      String      @db.Text
  inputTokens  Int         @default(0) @map("input_tokens")
  outputTokens Int         @default(0) @map("output_tokens")
  latencyMs    Int         @default(0) @map("latency_ms")
  fromCache    Boolean     @default(false) @map("from_cache")
  feature      String      @default("chat") @db.VarChar(50)
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@map("messages")
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

// ════════════════════════ 平台层：可观测 Trace/Span ════════════════════════
// 设计对标 Langfuse：Trace = 一次业务请求，Span = 其中的 LLM/工具/检索子调用

model Trace {
  id           String      @id @default(cuid())
  tenantId     String?     @map("tenant_id")
  userId       String?     @map("user_id")
  feature      String      @db.VarChar(50) // chat / rag / review / eval
  name         String      @db.VarChar(200)
  status       TraceStatus @default(RUNNING)
  model        String?     @db.VarChar(50)
  inputTokens  Int         @default(0) @map("input_tokens")
  outputTokens Int         @default(0) @map("output_tokens")
  costCny      Decimal     @default(0) @map("cost_cny") @db.Decimal(10, 4)
  latencyMs    Int         @default(0) @map("latency_ms")
  error        String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  spans  Span[]

  @@index([tenantId])
  @@index([userId])
  @@index([feature])
  @@index([createdAt])
  @@map("traces")
}

enum TraceStatus {
  RUNNING
  OK
  ERROR
}

model Span {
  id           String   @id @default(cuid())
  traceId      String   @map("trace_id")
  type         SpanType
  name         String   @db.VarChar(200)
  startedAt    DateTime @default(now()) @map("started_at")
  durationMs   Int      @default(0) @map("duration_ms")
  input        Json?
  output       Json?
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costCny      Decimal  @default(0) @map("cost_cny") @db.Decimal(10, 4)
  metadata     Json?

  trace Trace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId])
  @@index([type])
  @@map("spans")
}

enum SpanType {
  LLM
  TOOL
  RETRIEVER
}

// ════════════════════════ 平台层：离线评测 Eval ════════════════════════

model EvalCase {
  id        String     @id @default(cuid())
  type      EvalType
  title     String     @db.VarChar(200)
  input     Json
  expected  Json
  tags      String[]   @default([])
  source    EvalSource @default(MANUAL)
  active    Boolean    @default(true)
  tenantId  String?    @map("tenant_id") // null = 平台基线集
  createdAt DateTime   @default(now()) @map("created_at")

  results EvalResult[]

  @@index([type, active])
  @@map("eval_cases")
}

enum EvalType {
  RISK_DETECT  // 风险检出：precision/recall/F1
  RAG_RECALL   // 法规检索：recall@k
  FAITHFULNESS // 回答忠实度：LLM-as-Judge
}

enum EvalSource {
  MANUAL
  FEEDBACK
}

model EvalRun {
  id         String        @id @default(cuid())
  status     EvalRunStatus @default(RUNNING)
  summary    Json?
  caseCount  Int           @default(0) @map("case_count")
  passCount  Int           @default(0) @map("pass_count")
  commitSha  String?       @map("commit_sha") @db.VarChar(64)
  startedAt  DateTime      @default(now()) @map("started_at")
  finishedAt DateTime?     @map("finished_at")

  results EvalResult[]

  @@map("eval_runs")
}

enum EvalRunStatus {
  RUNNING
  DONE
  FAILED
}

model EvalResult {
  id           String   @id @default(cuid())
  runId        String   @map("run_id")
  caseId       String   @map("case_id")
  passed       Boolean  @default(false)
  score        Float    @default(0)
  actual       Json?
  judgeReason  String?  @map("judge_reason") @db.Text
  latencyMs    Int      @default(0) @map("latency_ms")
  createdAt    DateTime @default(now()) @map("created_at")

  run  EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  case EvalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([runId, caseId])
  @@index([runId])
  @@map("eval_results")
}

// ════════════════════════ 知识层：法规/模板库（PG 向量存储）════════════════════════
// demo 规模 embedding 以 JSON 存 PG、应用层余弦；生产平滑替换为 pgvector

model Document {
  id         String   @id @default(cuid())
  title      String   @db.VarChar(200)
  fileName   String   @map("file_name") @db.VarChar(300)
  docType    DocType  @default(GENERAL) @map("doc_type")
  category   String   @default("通用") @db.VarChar(50)
  chunkCount Int      @default(0) @map("chunk_count")
  charCount  Int      @default(0) @map("char_count")
  preview    String   @db.VarChar(500)
  tenantId   String?  @map("tenant_id")
  uploadedBy String?  @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  uploader User?       @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  chunks   DocChunk[]

  @@index([tenantId])
  @@index([docType])
  @@map("documents")
}

enum DocType {
  LEGAL    // 法规库
  TEMPLATE // 公司合同模板库
  GENERAL
}

model DocChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  embedding  Json     // number[] 向量
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("doc_chunks")
}

// ════════════════════════ 业务层：合同风险审查 ════════════════════════

model Contract {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  uploadedBy   String         @map("uploaded_by")
  title        String         @db.VarChar(200)
  fileName     String         @map("file_name") @db.VarChar(300)
  status       ContractStatus @default(UPLOADED)
  progress     Int            @default(0)
  parseError   String?        @map("parse_error") @db.Text
  fileType     String         @default("txt") @db.VarChar(20)
  scene        ReviewScene    @default(LABOR)
  charCount    Int            @default(0) @map("char_count")
  clausesCount Int            @default(0) @map("clauses_count")
  reportMd     String?        @map("report_md") @db.Text
  // 企业审查台「结构化信息」卡（FR：金额/期限/付款节点/关键义务，AI 抽取并缓存；无 Key 不生成）
  structuredInfo Json?        @map("structured_info")
  retainUntil  DateTime?      @map("retain_until")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader    User         @relation("ContractUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  clauses     Clause[]
  reviewTasks ReviewTask[]
  risks       Risk[]
  ledgerLinks ContractLedger[] @relation("LedgerLinkedContract")

  @@index([tenantId, status])
  @@index([retainUntil])
  @@map("contracts")
}

enum ContractStatus {
  UPLOADED
  PARSING
  READY
  REVIEWING
  WAITING_REVIEW
  COMPLETED
  FAILED
}

// 审查场景：FREE 仅前四类，CUSTOM 非标合同仅深度套餐/深度券
enum ReviewScene {
  LABOR    // 劳动合同
  LEASE    // 房屋租赁
  SERVICE  // 兼职/劳务
  NDA      // 保密协议
  CUSTOM   // 非标合同
}

model Clause {
  id         String     @id @default(cuid())
  contractId String     @map("contract_id")
  indexNo    Int        @map("index_no")
  title      String     @db.VarChar(200)
  content    String     @db.Text
  clauseType ClauseType @default(OTHER) @map("clause_type")
  metadata   Json?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  risks    Risk[]

  @@unique([contractId, indexNo])
  @@index([contractId])
  @@map("clauses")
}

enum ClauseType {
  PARTIES        // 缔约双方
  AMOUNT         // 价款/支付
  TERM           // 期限/交付
  BREACH         // 违约责任
  TERMINATION    // 解除/终止
  GOVERNING_LAW  // 适用法律/争议解决
  CONFIDENTIALITY
  IP             // 知识产权
  OTHER
}

model ReviewTask {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  contractId String           @map("contract_id")
  reviewerId String?          @map("reviewer_id")
  status     ReviewTaskStatus @default(RUNNING)
  threadId   String           @unique @map("thread_id") @db.VarChar(80)
  isDeep     Boolean          @default(false) @map("is_deep") // 本次是否解锁 Agent 深度轨（深度套餐或深度券）
  couponUsed Boolean          @default(false) @map("coupon_used") // 本次是否以深度券核销
  stats      Json?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  reviewer User?     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  risks    Risk[]

  @@index([tenantId, status])
  @@index([contractId])
  @@map("review_tasks")
}

enum ReviewTaskStatus {
  RUNNING
  WAITING_REVIEW
  APPROVED
  REJECTED
}

model Risk {
  id           String     @id @default(cuid())
  reviewTaskId String     @map("review_task_id")
  contractId   String     @map("contract_id")
  clauseId     String?    @map("clause_id")
  clauseTitle  String?    @map("clause_title") @db.VarChar(200)
  quote        String     @db.Text // 命中的原文片段（强制引用，治幻觉）
  severity     Severity
  category     String     @db.VarChar(50)
  title        String     @db.VarChar(200)
  analysis     String     @db.Text
  suggestion   String?    @db.Text
  legalBasis   String?    @map("legal_basis") @db.Text // 法规/模板依据
  // AI 改稿台（FR-9）：rewritten=可直接替换的改写句；revisionStatus=NONE/PENDING/ACCEPTED/REJECTED
  rewritten    String?    @db.Text
  revisionStatus String   @default("NONE") @map("revision_status") @db.VarChar(20)
  refs         Json?      // RAG 来源 [{docTitle, chunkId, score}]
  confidence   Float?
  detectedBy   RiskSource @default(AGENT) @map("detected_by")
  ruleId       String?    @map("rule_id") @db.VarChar(50)
  status       RiskStatus @default(PENDING)
  reviewerComment String? @map("reviewer_comment") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  reviewTask ReviewTask @relation(fields: [reviewTaskId], references: [id], onDelete: Cascade)
  contract   Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clause     Clause?    @relation(fields: [clauseId], references: [id], onDelete: SetNull)

  @@index([reviewTaskId])
  @@index([contractId])
  @@index([status])
  @@map("risks")
}

enum Severity {
  HIGH
  MED
  LOW
}

enum RiskSource {
  RULE
  AGENT
  BOTH
  PLAYBOOK // 企业 Playbook 公司红线/偏好规则命中（FR-17）
}

enum RiskStatus {
  PENDING
  ACCEPTED
  IGNORED
  EDITED
}

// 声明式审查规则：正则/关键词保底 + LLM 语义判定描述
model ReviewRule {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(200)
  severity    Severity @default(MED)
  category    String   @db.VarChar(50)
  scope       String   @default("ALL") @db.VarChar(20) // 适用范围：ALL=所有合同，LABOR=劳动/用工类合同
  pattern     String?  @db.Text // 正则，可空
  keywords    String[] @default([])
  prompt      String   @db.Text // 给模型的语义判定描述（Agent 轨使用）
  suggestion  String?  @db.Text // 命中后给用户的修改建议（规则轨直接产出）
  legalBasis  String?  @map("legal_basis") @db.Text // 法律依据原文出处
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(100) @map("sort_order")
  description String?  @db.Text // 风险解释（命中后写入 Risk.analysis）
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("review_rules")
}

// ════════════════════════ 平台层：审计与配置 ════════════════════════

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.VarChar(100)
  detail     Json?
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  tenantId   String?  @map("tenant_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Refresh Token 持久化：每次刷新轮转（旧 token 撤销 + replacedById 指向新 token）。
// 收到已撤销的 token = 疑似泄漏/重放，立即撤销该用户全部 refresh token，强制重新登录。
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id") @db.VarChar(50)
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255) // sha256(明文 refresh token)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.VarChar(50)
  ip           String?   @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(100)
  value     Json
  desc      String   @default("") @db.VarChar(500)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ════════════════════════ 增长改造 v2：台账 / Playbook / 订单 / 埋点 / 集成 ════════════════════════

// 合同台账：企业全生命周期管理，个人空间轻量复用（额度 ≤10）
model ContractLedger {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id") @db.VarChar(50)
  employeeName     String       @map("employee_name") @db.VarChar(100)
  dept             String?      @db.VarChar(100)
  // 7 类字符串枚举：FIXED_TERM_LABOR/OPEN_ENDED_LABOR/SERVICE/INTERNSHIP/NDA/NON_COMPETE/OTHER
  contractType     String       @default("FIXED_TERM_LABOR") @map("contract_type") @db.VarChar(30)
  startDate        DateTime     @map("start_date") @db.Date
  endDate          DateTime?    @map("end_date") @db.Date
  probationEnd     DateTime?    @map("probation_end") @db.Date
  position         String?      @db.VarChar(100)
  note             String?      @db.Text
  status           LedgerStatus @default(ACTIVE)
  linkedContractId String?      @map("linked_contract_id") @db.VarChar(50)
  renewedFromId    String?      @map("renewed_from_id") @db.VarChar(50)
  remindBeforeDays Int          @default(30) @map("remind_before_days")
  createdById      String?      @map("created_by_id") @db.VarChar(50)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedContract  Contract?         @relation("LedgerLinkedContract", fields: [linkedContractId], references: [id], onDelete: SetNull)
  renewedFrom     ContractLedger?   @relation("LedgerRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals        ContractLedger[]  @relation("LedgerRenewal")
  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, endDate])
  @@map("contract_ledgers")
}

enum LedgerStatus {
  ACTIVE
  RENEWED
  TERMINATED
}

// Playbook 企业自定义审查规则（企业护城河）
model PlaybookRule {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id") @db.VarChar(50)
  kind          PlaybookKind   @default(FORBIDDEN)
  title         String         @db.VarChar(200)
  description   String?        @db.Text
  naturalPrompt String         @default("") @map("natural_prompt") @db.Text
  // 结构化规则草稿：{ keywords?: string[], regex?: string, severity?: ..., prompt?: string }
  pattern       Json?
  contractTypes String[]       @default([]) @map("contract_types")
  enabled       Boolean        @default(true)
  hitCount      Int            @default(0) @map("hit_count")
  source        PlaybookSource @default(MANUAL)
  createdById   String?        @map("created_by_id") @db.VarChar(50)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, enabled])
  @@map("playbook_rules")
}

enum PlaybookKind {
  FORBIDDEN   // 红线规则（禁止条款）
  PREFERENCE  // 偏好口径
  STANDARD    // 企业标准合同库
  INDUSTRY    // 行业专项包
}

enum PlaybookSource {
  MANUAL
  AI
  SEED_PACK
}

// 模拟订单：不接真实支付，收银台一键 PAID 立即生效
model Order {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id") @db.VarChar(50)
  kind        OrderKind
  period      OrderPeriod?
  targetPlan  String?      @map("target_plan") @db.VarChar(20)
  couponQty   Int?         @map("coupon_qty")
  amountFen   Int          @default(0) @map("amount_fen")
  status      OrderStatus  @default(PENDING)
  createdById String?      @map("created_by_id") @db.VarChar(50)
  paidAt      DateTime?    @map("paid_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("orders")
}

enum OrderKind {
  SUBSCRIPTION
  COUPON_PACK
  UPGRADE
}

enum OrderPeriod {
  MONTH
  YEAR
  NONE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

// 增长埋点事件：只采事件与属性元数据，绝不采合同正文/风险全文
model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id") @db.VarChar(50)
  userId    String?  @map("user_id") @db.VarChar(50)
  type      String   @db.VarChar(50)
  path      String?  @db.VarChar(500)
  props     Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@map("analytics_events")
}

// 集成配置：P0 飞书群机器人 Webhook（config 加密存储、脱敏返回）
model IntegrationConfig {
  id         String              @id @default(cuid())
  tenantId   String              @unique @map("tenant_id") @db.VarChar(50)
  provider   IntegrationProvider @default(FEISHU)
  config     Json                @default("{}")
  status     IntegrationStatus   @default(NOT_CONFIGURED)
  lastTestAt DateTime?           @map("last_test_at")
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("integration_configs")
}

enum IntegrationProvider {
  FEISHU
}

enum IntegrationStatus {
  NOT_CONFIGURED
  ACTIVE
}

// 集成中心「联系开通」留资（钉钉/企微/电子签/OA/SSO/Open API/Word 插件/私有化）
model IntegrationLead {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id") @db.VarChar(50)
  userId      String?  @map("user_id") @db.VarChar(50)
  integration String   @db.VarChar(30)
  name        String   @db.VarChar(100)
  phone       String   @db.VarChar(30)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation("IntegrationLeadUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("integration_leads")
}
